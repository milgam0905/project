  "transitions": [
    {
      "from": "idle",
      "to": "walk",
      "crossfade_s": 0.18,
      "sync": "Start at left front/left foot strike"
    },
    {
      "from": "walk",
      "to": "run",
      "crossfade_s": 0.2,
      "sync": "Retain normalized gait phase; see species gait change note"
    },
    {
      "from": "run",
      "to": "walk",
      "crossfade_s": 0.24,
      "sync": "Retain phase and decelerate world displacement together"
    },
    {
      "from": "walk/run",
      "to": "idle",
      "crossfade_s": 0.2,
      "sync": "Prefer next planted foot; optional foot locking"
    },
    {
      "from": "idle",
      "to": "turn_left/turn_right",
      "crossfade_s": 0.12,
      "sync": "Consume root yaw exactly once"
    },
    {
      "from": "turn_left/turn_right",
      "to": "idle",
      "crossfade_s": 0.14,
      "sync": "Accumulate final yaw into controller; remove/reset clip root yaw before next idle"
    },
    {
      "from": "locomotion",
      "to": "jump",
      "crossfade_s": 0.1,
      "sync": "Preserve horizontal velocity externally; root Z provides vertical arc"
    },
    {
      "from": "jump",
      "to": "locomotion",
      "crossfade_s": 0.16,
      "sync": "Blend after landing; start target gait at a planted contact"
    },
    {
      "from": "locomotion",
      "to": "attack",
      "crossfade_s": 0.12,
      "sync": "Full body attack; stop or reduce movement"
    },
    {
      "from": "attack",
      "to": "locomotion",
      "crossfade_s": 0.18,
      "sync": "After recovery marker"
    }
  ],
  "rotation_interpolation": {
    "rotation_format": "GLB quaternion channels",
    "method": "shortest-arc slerp with quaternion sign correction",
    "neutral_clip": "Turn_Base",
    "rules": [
      "Turn_Base is a reference pose, not an additive animation by itself",
      "For additive turning calculate local rotation delta against Turn_Base",
      "Turn clips include real root yaw; choose animation root authority or controller authority once",
      "For an arbitrary target yaw scale the root yaw delta; large angles should chain turns",
      "Idle/walk/run can be directionally reoriented by a controller; no strafing clips are supplied"
    ]
  },
  "root_motion": {
    "walk_run": "In-place horizontal locomotion; controller supplies translation from nominal stride speed",
    "turn": "Root yaw +90/-90, ends at new heading",
    "jump": "Transient vertical root displacement returns to ground; horizontal velocity is external",
    "animal_attack": "Transient local forward root excursion returns to origin; not a permanent dash"
  },
  "runtime_status": "Authoring data only. No mixer, IK foot locking, AI, collision or engine integration implemented."
}